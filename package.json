{
  "name": "@devhelm/sdk",
  "version": "1.11.0",
  "description": "DevHelm SDK for TypeScript and JavaScript \u2014 typed client for monitors, incidents, alerting, and more",
  "author": "DevHelm <hello@devhelm.io>",
  "license": "MIT",
  "homepage": "https://github.com/devhelmhq/sdk-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/devhelmhq/sdk-js.git"
  },
  "bugs": "https://github.com/devhelmhq/sdk-js/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./bundler": {
      "types": "./dist/bundler/index.d.ts",
      "import": "./dist/bundler/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typegen": "node scripts/generate-types.js",
    "schemagen": "node scripts/generate-schemas.js",
    "codegen": "npm run versiongen && npm run typegen && npm run schemagen",
    "build": "npm run codegen && tsc -b",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run codegen && tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "versiongen": "node scripts/generate-version.js",
    "test:e2e": "vitest run test/e2e",
    "check:public-types": "node scripts/check-public-types.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "devhelm",
    "monitoring",
    "sdk",
    "typescript",
    "uptime",
    "api-client"
  ],
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "ajv": "^8.18.0",
    "eslint": "^10.2.0",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "^1.18.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "sideEffects": false
}
